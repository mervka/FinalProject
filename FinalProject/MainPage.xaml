<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="FinalProject.MainPage"
             x:Name="MainPageView">
    <Grid BackgroundColor="#F5F5DC">

        <!-- 1) 3 Satir: TopBar / Room / BottomBar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =======================
             TOP BAR (Row 0)
        ======================== -->
        <Grid Grid.Row="0" Padding="16,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Label Text="{Binding PatiCoinsText}"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#8B4513"
                   HorizontalOptions="End"
                   VerticalOptions="Center"/>
            
            <Frame Grid.Row="1"
                   Padding="10,6"
                   CornerRadius="14"
                   BackgroundColor="#FFF8E1"
                   HasShadow="False">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,*,Auto,Auto,*,Auto"
                      ColumnSpacing="10"
                      RowSpacing="6">
                    <Label Text="🍗"
                           FontSize="14"
                           VerticalOptions="Center"/>
                    <ProgressBar Grid.Column="1"
                                 Progress="{Binding HungerProgress}"
                                 ProgressColor="#FFA726"
                                 HeightRequest="10"/>
                    <Label Grid.Column="2"
                           Text="{Binding Hunger}"
                           FontSize="12"
                           TextColor="#8B4513"
                           VerticalOptions="Center"/>

                    <Label Grid.Column="3"
                           Text="🎾"
                           FontSize="14"
                           VerticalOptions="Center"/>
                    <ProgressBar Grid.Column="4"
                                 Progress="{Binding HappinessProgress}"
                                 ProgressColor="#66BB6A"
                                 HeightRequest="10"/>
                    <Label Grid.Column="5"
                           Text="{Binding Happiness}"
                           FontSize="12"
                           TextColor="#8B4513"
                           VerticalOptions="Center"/>

                    <Label Grid.Column="6"
                           Text="💊"
                           FontSize="14"
                           VerticalOptions="Center"/>
                    <ProgressBar Grid.Column="7"
                                 Progress="{Binding HealthProgress}"
                                 ProgressColor="#42A5F5"
                                 HeightRequest="10"/>
                    <Label Grid.Column="8"
                           Text="{Binding Health}"
                           FontSize="12"
                           TextColor="#8B4513"
                           VerticalOptions="Center"/>
                </Grid>
            </Frame>
        </Grid>

        <!-- =======================
             ROOM AREA (Row 1)
        ======================== -->
        <AbsoluteLayout Grid.Row="1" Margin="12">

            <!-- HOME PET (Sadece session çalışmıyorken görünsün) -->
            <skia:SKLottieView
                Source="{Binding LottieSource}"
                RepeatCount="-1"
                HeightRequest="260"
                WidthRequest="260"
                AbsoluteLayout.LayoutBounds="0.5,0.62,260,260"
                AbsoluteLayout.LayoutFlags="PositionProportional">

                <!-- ✅ Session başlayınca bunu gizliyoruz (çift animasyon olmasın diye) -->
                <skia:SKLottieView.Triggers>
                    <DataTrigger TargetType="skia:SKLottieView"
                                 Binding="{Binding IsSessionRunning}"
                                 Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </skia:SKLottieView.Triggers>
            </skia:SKLottieView>

        </AbsoluteLayout>

        <!-- =======================
             BOTTOM BAR (Row 2)
             (Overlay açıkken görünmesin)
        ======================== -->
        <Grid Grid.Row="2" Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ✅ Running veya Picker açıkken BottomBar'ı sakla -->
            <Grid.Triggers>
                <DataTrigger TargetType="Grid"
                             Binding="{Binding IsSessionRunning}"
                             Value="True">
                    <Setter Property="IsVisible" Value="False"/>
                </DataTrigger>
                <DataTrigger TargetType="Grid"
                             Binding="{Binding IsDurationPickerVisible}"
                             Value="True">
                    <Setter Property="IsVisible" Value="False"/>
                </DataTrigger>
                <DataTrigger TargetType="Grid"
                             Binding="{Binding IsShopVisible}"
                             Value="True">
                    <Setter Property="IsVisible" Value="False"/>
                </DataTrigger>
            </Grid.Triggers>

            <Button Grid.Column="0"
                    Text="🛒"
                    FontSize="22"
                    BackgroundColor="Transparent"
                    Command="{Binding ShowShopCommand}"/>

            <Button Grid.Column="1"
                    Text="FOCUS!"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="#FFB74D"
                    TextColor="Black"
                    CornerRadius="18"
                    HeightRequest="52"
                    HorizontalOptions="Center"
                    WidthRequest="200"
                    Command="{Binding ShowDurationPickerCommand}"/>

            <Button Grid.Column="2"
                    Text="📊"
                    FontSize="22"
                    BackgroundColor="Transparent"/>
        </Grid>
        
           <!-- ======================================================
             OVERLAY: Shop
        ======================================================= -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsShopVisible}">

            <BoxView Color="Black" Opacity="0.55"/>

            <Frame Padding="16"
                   CornerRadius="20"
                   BackgroundColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   WidthRequest="400"
                   HeightRequest="560">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="12">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto"
                          VerticalOptions="Center">
                        <Label Text="Shop"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                Text="✕"
                                FontSize="12"
                                Padding="6,2"
                                HeightRequest="28"
                                WidthRequest="28"
                                BackgroundColor="#E0E0E0"
                                CornerRadius="10"
                                Command="{Binding HideShopCommand}"/>
                    </Grid>

                    <Grid Grid.Row="1"
                          RowDefinitions="Auto,*"
                          RowSpacing="10"
                          VerticalOptions="FillAndExpand">
                        <CollectionView ItemsSource="{Binding ShopCategories}"
                                        SelectedItem="{Binding SelectedShopCategory}"
                                        
                                        SelectionMode="Single"
                                        HeightRequest="52"
                                        HorizontalOptions="Center">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal"
                                                   ItemSpacing="8"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="12,6"
                                           CornerRadius="12"
                                           HasShadow="False"
                                           BackgroundColor="#F3EEE8">
                                        <Frame.Triggers>
                                            <DataTrigger TargetType="Frame"
                                                         Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor" Value="#FFD8A8"/>
                                            </DataTrigger>
                                        </Frame.Triggers>
                                        <Label Text="{Binding Name}"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="TailTruncation"/>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <CollectionView Grid.Row="1"
                                        ItemsSource="{Binding VisibleShopItems}"
                                        SelectionMode="None"
                                        VerticalOptions="FillAndExpand">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical"
                                                 Span="2"
                                                 HorizontalItemSpacing="10"
                                                 VerticalItemSpacing="10"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="10"
                                           CornerRadius="12"
                                           HasShadow="False"
                                           BackgroundColor="#F9F6F1">
                                        <Grid ColumnDefinitions="Auto,*"
                                              RowDefinitions="Auto,Auto,Auto"
                                              ColumnSpacing="8"
                                              RowSpacing="4">
                                            <Label Text="{Binding Icon}"
                                                   FontSize="20"
                                                   VerticalOptions="Center"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center"/>

                                            <Label Grid.Row="1"
                                                   Grid.Column="1"
                                                   Text="{Binding Description}"
                                                   FontSize="12"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="#666"/>

                                            <Label Grid.Row="2"
                                                   Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding Price, StringFormat='{0} 🐾'}"
                                                   FontSize="12"
                                                   TextColor="#8B4513"/>

                                            <Button Grid.Row="2"
                                                    Grid.Column="1"
                                                    Text="Buy"
                                                    FontSize="12"
                                                    HorizontalOptions="End"
                                                    Command="{Binding BindingContext.BuyItemCommand, Source={x:Reference MainPageView}}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>
            </Frame>
        </Grid>
        
        <!-- ======================================================
     OVERLAY 1: Süre Seçimi
======================================================= -->
<Grid Grid.RowSpan="3"
      ZIndex="50"
      InputTransparent="False"
      IsVisible="{Binding IsDurationPickerVisible}">

    <!-- Arka plan karartma: tıklama yemesin -->
    <BoxView Color="Black"
             Opacity="0.55"
             InputTransparent="True"
             ZIndex="50"/>

    <!-- Popup: en üstte -->
    <Frame Padding="16"
           CornerRadius="20"
           BackgroundColor="White"
           HorizontalOptions="Center"
           VerticalOptions="Center"
           WidthRequest="300"
           ZIndex="51"
           InputTransparent="False">

        <VerticalStackLayout Spacing="12">
            <Label Text="Süre Seç"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="1"
                        Command="{Binding BindingContext.SelectDurationCommand, Source={x:Reference MainPageView}}"
                        CommandParameter="1"/>
                <Button Text="15"
                        Command="{Binding BindingContext.SelectDurationCommand, Source={x:Reference MainPageView}}"
                        CommandParameter="15"/>
                <Button Text="25"
                        Command="{Binding BindingContext.SelectDurationCommand, Source={x:Reference MainPageView}}"
                        CommandParameter="25"/>
                <Button Text="50"
                        Command="{Binding BindingContext.SelectDurationCommand, Source={x:Reference MainPageView}}"
                        CommandParameter="50"/>
            </HorizontalStackLayout>

            <Label Text="{Binding SelectedMinutes, StringFormat='Seçilen: {0} dk'}"
                   HorizontalOptions="Center"/>

            <Button Text="START"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    Command="{Binding BindingContext.StartFromPickerCommand, Source={x:Reference MainPageView}}"/>

            <Button Text="BACK"
                    BackgroundColor="Firebrick"
                    TextColor="White"
                    Command="{Binding BindingContext.HideDurationPickerCommand, Source={x:Reference MainPageView}}"/>
        </VerticalStackLayout>
    </Frame>
</Grid>


        <!-- ======================================================
             OVERLAY 2: Running
        ======================================================= -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsSessionRunning}">

            <BoxView Color="Black" Opacity="0.75"/>

            <Label Text="DON'T INTERRUPT ME!"
                   TextColor="Coral"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Start"
                   Margin="0,160,0,0"/>

            <!-- Session sırasında pet + timer görünsün-->
            <Grid HorizontalOptions="Center" VerticalOptions="Center">

                <skia:SKLottieView
                    Source="{Binding LottieSource}"
                    RepeatCount="-1"
                    HeightRequest="240"
                    WidthRequest="240"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>

                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Margin="0,200,0,0"
                                     Spacing="6">
                    <Label Text="{Binding SessionTypeText}"
                           TextColor="Coral"
                           FontSize="18"
                           HorizontalOptions="Center"/>

                    <Label Text="{Binding RemainingTimeText}"
                           TextColor="Wheat"
                           FontSize="48"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <Button Text="CANCEL"
                    Command="{Binding CancelSessionCommand}"
                    BackgroundColor="#EF5350"
                    TextColor="White"
                    CornerRadius="16"
                    HeightRequest="52"
                    WidthRequest="220"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Margin="0,0,0,40"/>
        </Grid>
    </Grid>
</ContentPage>

    

